# Database Configuration
DATABASE_URL="postgresql://postgres:password@localhost:5432/epm_tracker?schema=public"

# JWT Authentication Configuration
JWT_SECRET="your-super-secret-jwt-key-here-must-be-at-least-32-chars"
JWT_EXPIRATION="24h"

# Server Port
PORT=3000

# CORS Origins (comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Location Tracking Interval (in minutes)
TRACKING_INTERVAL_MINUTES=2

# Face Recognition Configuration
FACE_MATCH_THRESHOLD=0.5
FACE_GLOBAL_MATCH_THRESHOLD=0.35
ARCFACE_SERVICE_URL=http://localhost:5050
